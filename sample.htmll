                const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
                
                // Add/remove scrolled class based on scroll position
                if (scrollTop > 100) {
                    navbar.classList.add('scrolled');
                } else {
                    navbar.classList.remove('scrolled');
                }
                
                lastScrollTop = scrollTop <= 0 ? 0 : scrollTop; // For mobile or negative scrolling
            });
            
            // ===========================================
            // SMOOTH SCROLLING FOR NAVIGATION LINKS
            // ===========================================
            
            const navLinks = document.querySelectorAll('a[href^="#"]');
            
            navLinks.forEach(function(link) {
                link.addEventListener('click', function(e) {
                    e.preventDefault();
                    
                    const targetId = this.getAttribute('href').substring(1);
                    const targetElement = document.getElementById(targetId);
                    
                    if (targetElement) {
                        const offsetTop = targetElement.offsetTop - 80; // Account for fixed navbar
                        
                        window.scrollTo({
                            top: offsetTop,
                            behavior: 'smooth'
                        });
                        
                        // Close mobile menu if open
                        const navbarCollapse = document.querySelector('.navbar-collapse');
                        if (navbarCollapse.classList.contains('show')) {
                            const bsCollapse = new bootstrap.Collapse(navbarCollapse, {
                                toggle: false
                            });
                            bsCollapse.hide();
                        }
                    }
                });
            });
            
            // ===========================================
            // INTERSECTION OBSERVER FOR FADE-IN ANIMATIONS
            // ===========================================
            
            const fadeElements = document.querySelectorAll('.fade-in');
            
            const fadeObserver = new IntersectionObserver(function(entries) {
                entries.forEach(function(entry) {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                        
                        // Add staggered animation delay for multiple elements
                        const index = Array.from(entry.target.parentNode.children).indexOf(entry.target);
                        entry.target.style.animationDelay = (index * 0.1) + 's';
                    }
                });
            }, {
                threshold: 0.1,
                rootMargin: '0px 0px -50px 0px'
            });
            
            fadeElements.forEach(function(element) {
                fadeObserver.observe(element);
            });
            
            // ===========================================
            // ACTIVE NAVIGATION HIGHLIGHTING
            // ===========================================
            
            const sections = document.querySelectorAll('section[id]');
            const navItems = document.querySelectorAll('.navbar-nav .nav-link');
            
            const sectionObserver = new IntersectionObserver(function(entries) {
                entries.forEach(function(entry) {
                    if (entry.isIntersecting) {
                        const currentSection = entry.target.getAttribute('id');
                        
                        // Remove active class from all nav items
                        navItems.forEach(function(navItem) {
                            navItem.classList.remove('active');
                        });
                        
                        // Add active class to current section's nav item
                        const activeNavItem = document.querySelector('.navbar-nav .nav-link[href="#' + currentSection + '"]');
                        if (activeNavItem) {
                            activeNavItem.classList.add('active');
                        }
                    }
                });
            }, {
                threshold: 0.3,
                rootMargin: '-80px 0px -80px 0px'
            });
            
            sections.forEach(function(section) {
                sectionObserver.observe(section);
            });
            
            // ===========================================
            // VILLA CARD HOVER EFFECTS
            // ===========================================
            
            const villaCards = document.querySelectorAll('.villa-card');
            
            villaCards.forEach(function(card) {
                card.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateY(-10px) scale(1.02)';
                });
                
                card.addEventListener('mouseleave', function() {
                    this.style.transform = 'translateY(0) scale(1)';
                });
            });
            
            // ===========================================
            // GALLERY ITEM INTERACTIONS
            // ===========================================
            
            const galleryItems = document.querySelectorAll('.gallery-item');
            
            galleryItems.forEach(function(item) {
                item.addEventListener('click', function() {
                    const text = this.querySelector('.gallery-text').textContent;
                    
                    // Simple alert for demo - in production, you might open a lightbox
                    alert('Opening gallery for: ' + text + '\n\nIn a real implementation, this would open a photo gallery or lightbox.');
                });
                
                // Add keyboard accessibility
                item.setAttribute('tabindex', '0');
                item.setAttribute('role', 'button');
                item.setAttribute('aria-label', 'View gallery images');
                
                item.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        this.click();
                    }
                });
            });
            
            // ===========================================
            // BOOKING PLATFORM LINK TRACKING
            // ===========================================
            
            const bookingLinks = document.querySelectorAll('.platform-btn, .book-btn');
            
            bookingLinks.forEach(function(link) {
                link.addEventListener('click', function(e) {
                    const platform = this.textContent.trim();
                    
                    // In a real implementation, you might send analytics data here
                    console.log('Booking attempt via:', platform);
                    
                    // Add a brief loading state
                    const originalText = this.innerHTML;
                    this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Opening...';
                    this.style.pointerEvents = 'none';
                    
                    setTimeout(() => {
                        this.innerHTML = originalText;
                        this.style.pointerEvents = 'auto';
                    }, 1500);
                });
            });
            
            // ===========================================
            // WHATSAPP LINK ENHANCEMENT
            // ===========================================
            
            const whatsappLinks = document.querySelectorAll('a[href*="wa.me"]');
            
            whatsappLinks.forEach(function(link) {
                // Enhance WhatsApp links with proper formatting
                link.addEventListener('click', function(e) {
                    // Add analytics tracking or additional logic here
                    console.log('WhatsApp contact initiated');
                });
            });
            
            // ===========================================
            // FORM VALIDATION (if forms are added later)
            // ===========================================
            
            function validateEmail(email) {
                const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                return re.test(email);
            }
            
            // ===========================================
            // PERFORMANCE OPTIMIZATIONS
            // ===========================================
            
            // Lazy loading for images (when real images are added)
            function lazyLoadImages() {
                const images = document.querySelectorAll('img[data-src]');
                
                const imageObserver = new IntersectionObserver(function(entries) {
                    entries.forEach(function(entry) {
                        if (entry.isIntersecting) {
                            const img = entry.target;
                            img.src = img.dataset.src;
                            img.classList.add('loaded');
                            imageObserver.unobserve(img);
                        }
                    });
                });
                
                images.forEach(function(img) {
                    imageObserver.observe(img);
                });
            }
            
            // Initialize lazy loading
            lazyLoadImages();
            
            // ===========================================
            // ACCESSIBILITY ENHANCEMENTS
            // ===========================================
            
            // Skip link functionality
            const skipLink = document.querySelector('.skip-link');
            if (skipLink) {
                skipLink.addEventListener('click', function(e) {
                    e.preventDefault();
                    const target = document.querySelector(this.getAttribute('href'));
                    if (target) {
                        target.focus();
                        target.scrollIntoView();
                    }
                });
            }
            
            // Keyboard navigation for interactive elements
            document.addEventListener('keydown', function(e) {
                // ESC key to close mobile menu
                if (e.key === 'Escape') {
                    const navbarCollapse = document.querySelector('.navbar-collapse.show');
                    if (navbarCollapse) {
                        const bsCollapse = new bootstrap.Collapse(navbarCollapse, {
                            toggle: false
                        });
                        bsCollapse.hide();
                    }
                }
            });
            
            // ===========================================
            // DYNAMIC CONTENT LOADING
            // ===========================================
            
            // Function to load additional content (for future enhancements)
            function loadContent(url, targetElement) {
                fetch(url)
                    .then(response => response.text())
                    .then(data => {
                        targetElement.innerHTML = data;
                        
                        // Re-initialize observers for new content
                        const newFadeElements = targetElement.querySelectorAll('.fade-in');
                        newFadeElements.forEach(function(element) {
                            fadeObserver.observe(element);
                        });
                    })
                    .catch(error => {
                        console.error('Error loading content:', error);
                        targetElement.innerHTML = '<p>Error loading content. Please refresh the page.</p>';
                    });
            }
            
            // ===========================================
            // ERROR HANDLING
            // ===========================================
            
            // Global error handler for any JavaScript errors
            window.addEventListener('error', function(e) {
                console.error('Global error:', e.error);
                
                // In production, you might want to send error reports to a service
                // logErrorToService(e.error);
            });
            
            // ===========================================
            // UTILITY FUNCTIONS
            // ===========================================
            
            // Debounce function for performance optimization
            function debounce(func, wait, immediate) {
                let timeout;
                return function executedFunction() {
                    const context = this;
                    const args = arguments;
                    
                    const later = function() {
                        timeout = null;
                        if (!immediate) func.apply(context, args);
                    };
                    
                    const callNow = immediate && !timeout;
                    clearTimeout(timeout);
                    timeout = setTimeout(later, wait);
                    
                    if (callNow) func.apply(context, args);
                };
            }
            
            // Throttle function for scroll events
            function throttle(func, limit) {
                let inThrottle;
                return function() {
                    const args = arguments;
                    const context = this;
                    if (!inThrottle) {
                        func.apply(context, args);
                        inThrottle = true;
                        setTimeout(() => inThrottle = false, limit);
                    }
                }
            }
            
            // ===========================================
            // INITIALIZATION COMPLETE
            // ===========================================
            
            console.log('Green Villa website initialized successfully');
            
            // Add a subtle loading animation completion
            document.body.classList.add('loaded');
            
        }); // End of DOMContentLoaded event listener
        
        // ===========================================
        // ADDITIONAL UTILITY FUNCTIONS (Global Scope)
        // ===========================================
        
        // Function to update villa availability (for future integration)
        function updateAvailability(villaId, isAvailable) {
            const villaElement = document.querySelector(`[data-villa-id="${villaId}"]`);
            if (villaElement) {
                const bookButton = villaElement.querySelector('.book-btn');
                if (bookButton) {
                    if (isAvailable) {
                        bookButton.classList.remove('disabled');
                        bookButton.textContent = bookButton.textContent.replace('Not Available', 'Book Now');
                    } else {
                        bookButton.classList.add('disabled');
                        bookButton.textContent = bookButton.textContent.replace('Book Now', 'Not Available');
                    }
                }
            }
        }
        
        // Function to show success/error messages
        function showMessage(message, type = 'info') {
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
            alertDiv.style.cssText = 'top: 100px; right: 20px; z-index: 9999; max-width: 400px;';
            alertDiv.innerHTML = `
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            
            document.body.appendChild(alertDiv);
            
            // Auto-remove after 5 seconds
            setTimeout(() => {
                if (alertDiv.parentNode) {
                    alertDiv.parentNode.removeChild(alertDiv);
                }
            }, 5000);
        }
        
        // Function to format phone numbers (Sri Lankan format)
        function formatPhoneNumber(phone) {
            // Remove all non-numeric characters
            const cleaned = phone.replace(/\D/g, '');
            
            // Format as Sri Lankan number
            if (cleaned.length === 10 && cleaned.startsWith('0')) {
                return '+94 ' + cleaned.substring(1, 3) + ' ' + cleaned.substring(3, 6) + ' ' + cleaned.substring(6);
            } else if (cleaned.length === 9) {
                return '+94 ' + cleaned.substring(0, 2) + ' ' + cleaned.substring(2, 5) + ' ' + cleaned.substring(5);
            }
            
            return phone; // Return original if doesn't match expected format
        }
        
    </script>

    <!-- Additional CSS for JavaScript enhancements -->
    <style>
        /* Loading state styles */
        body:not(.loaded) {
            overflow: hidden;
        }
        
        body:not(.loaded)::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: var(--white);
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        /* Active navigation item */
        .navbar-nav .nav-link.active {
            color: var(--primary-green) !important;
            font-weight: 600;
        }
        
        /* Enhanced gallery hover effects */
        .gallery-item {
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .gallery-item:focus {
            outline: 3px solid var(--accent-green);
            outline-offset: 4px;
        }
        
        /* Disabled button states */
        .btn:disabled,
        .btn.disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        
        /* Skip link for accessibility */
        .skip-link {
            position: absolute;
            top: -40px;
            left: 6px;
            background: var(--primary-green);
            color: white;
            padding: 8px;
            text-decoration: none;
            transition: top 0.3s;
            z-index: 10000;
        }
        
        .skip-link:focus {
            top: 6px;
        }
        
        /* Smooth transitions for all interactive elements */
        a, button, .btn, .villa-card, .service-card, .gallery-item {
            transition: all 0.3s ease;
        }
        
        /* High contrast mode support */
        @media (prefers-contrast: high) {
            :root {
                --primary-green: #1a3a15;
                --secondary-green: #2d4a25;
                --light-text: #333333;
            }
        }
        
        /* Reduced motion support */
        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }
            
            html {
                scroll-behavior: auto;
            }
        }
        
        /* Print optimizations */
        @media print {
            .fade-in {
                opacity: 1 !important;
                transform: none !important;
            }
        }
    </style>

